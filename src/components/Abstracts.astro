---
import type { PaperMetadata } from "../lib/posts";

interface Props {
  metadata: PaperMetadata;
  headingLevel?: "h2" | "h3";
}

const { metadata, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

<div class="abstracts">
  <section class="abstract abstract-en">
    <Heading>arXiv Abstract</Heading>
    <p lang="en">{metadata.arxivAbstract}</p>
  </section>
  <section class="abstract abstract-ja">
    <Heading>日本語要約</Heading>
    <p>{metadata.abstractJa}</p>
  </section>
</div>
