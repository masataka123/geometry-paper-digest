---
import type { Paper } from "../lib/posts";
import type { Topic } from "../lib/topics";
import { withBase } from "../lib/urls";
import type { PaperAuthor } from "../lib/authors";
import { resolveTagIds, tagUrl } from "../lib/tags";

interface Props { paper: Paper; topic?: Topic; authors: PaperAuthor[]; }
const { paper, topic, authors } = Astro.props;
const tags = await resolveTagIds(paper.metadata.tags);
---
<article class="paper-card" data-paper data-pathname={paper.route.pathname} data-author-ids={authors.map(({id}) => id).join(" ")} data-tags={paper.metadata.tags.join(" ")} data-topic={paper.metadata.topic} data-arxiv-submitted={paper.metadata.arxivSubmitted} data-site-date={paper.date}>
  <div class="paper-card__meta">
    <span>{paper.metadata.arxivSubmitted}</span>
    <span>{topic?.title ?? paper.metadata.topic}</span>
    <span>{paper.metadata.arxivId}</span>
  </div>
  <h2><a href={withBase(paper.route.pathname)}>{paper.metadata.title}</a></h2>
  <p class="paper-card__authors">{authors.map((author, index) => <>{index > 0 && ", "}<a href={withBase(`/authors/${author.id}/`)}>{author.displayName}</a></>)}</p>
  {tags.length > 0 && <ul class="tag-chips" aria-label="タグ">{tags.map((tag) => <li><a href={tagUrl(tag.id)}>{tag.nameJa}</a></li>)}</ul>}
  <section class="paper-card__abstract" lang="en">
    <h3>arXiv Abstract</h3>
    <p>{paper.metadata.arxivAbstract}</p>
  </section>
  <section class="paper-card__japanese-summary">
    <h3>日本語要約</h3>
    <p>{paper.metadata.summary}</p>
  </section>
  <p class="paper-card__links">
    <a href={withBase(paper.route.pathname)}>日本語記事</a>
    <a href={paper.metadata.arxivUrl} rel="noopener">arXiv</a>
  </p>
</article>
