---
import "../../assets/css/style.css";
import "../styles/phase2.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "",
  description = "代数幾何学・複素幾何学・多変数複素解析の新着論文を日本語で紹介します。",
} = Astro.props;
const siteTitle = "Geometry Paper Digest";
---

<!doctype html>
<html lang="ja" data-base-url={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title ? `${title} | ${siteTitle}` : siteTitle}</title>
    <script is:inline>
      window.MathJax = {
        tex: {
          inlineMath: [['$', '$'], ['\\(', '\\)']],
          displayMath: [['$$', '$$'], ['\\[', '\\]']],
          processEscapes: true,
          tags: 'ams'
        },
        svg: { fontCache: 'global' }
      };
    </script>
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
  </head>
  <body>
    <main>
      <slot />
      <footer class="site-footer" data-pagefind-ignore="all">
        <p><a href={`${import.meta.env.BASE_URL}authors/`}>著者一覧</a> · <a href={`${import.meta.env.BASE_URL}tags/`}>タグ一覧</a></p>
        <p>本サイトは岩井が楽をしたいという非営利目的で作られました。原論文、Abstract、図表等の著作権は各著者・権利者に帰属します。Github リポジトリは<a href="https://github.com/masataka123/geometry-paper-digest">こちら</a>です。</p>
      </footer>
    </main>
  </body>
</html>

<script>
  import { filterAndSortPapers, normalizeSearchQuery, readFilterState, stateToSearch } from "../lib/paper-filters.mjs";

  let matchedPathnames: Set<string> | null = null;
  let searchSequence = 0;

  function controls(form: HTMLFormElement) {
    const data = new FormData(form);
    return { q: String(data.get("q") ?? ""), author: String(data.get("author") ?? "all"), tag: String(data.get("tag") ?? "all"), topic: String(data.get("topic") ?? "all"), year: String(data.get("year") ?? "all"), month: String(data.get("month") ?? "all"), sort: String(data.get("sort") ?? "arxiv-newest") };
  }

  function updatePaperList() {
    const form = document.querySelector("[data-filter-bar]");
    const list = document.querySelector("[data-paper-list]");
    if (!(form instanceof HTMLFormElement) || !(list instanceof HTMLElement)) return;
    const cards = [...list.querySelectorAll<HTMLElement>("[data-paper]")];
    const topicControl = form.elements.namedItem("topic");
    const yearControl = form.elements.namedItem("year");
    const topics = topicControl instanceof HTMLSelectElement ? [...topicControl.options].map((option) => option.value) : ["all"];
    const years = yearControl instanceof HTMLSelectElement ? [...yearControl.options].map((option) => option.value) : ["all"];
    const tagControl = form.elements.namedItem("tag");
    const tags = tagControl instanceof HTMLSelectElement ? [...tagControl.options].map((option) => option.value) : ["all"];
    const authorOptions = [...form.querySelectorAll<HTMLOptionElement>("#author-options option")];
    const authors = ["all", ...authorOptions.map((option) => option.dataset.authorId ?? "")];
    const state = readFilterState(location.search, topics, years, authors, tags);
    const authorName = form.elements.namedItem("authorName");
    if (authorName instanceof HTMLInputElement) authorName.value = authorOptions.find((option) => option.dataset.authorId === state.author)?.value ?? "";
    const fixedTopic = list.dataset.fixedTopic;
    if (fixedTopic) state.topic = fixedTopic;
    for (const [key, value] of Object.entries(state)) {
      const control = form.elements.namedItem(key);
      if (control instanceof HTMLSelectElement || control instanceof HTMLInputElement) control.value = value ?? "";
    }
    const records = cards.map((element) => ({
      element, pathname: element.dataset.pathname ?? "", authorIds: (element.dataset.authorIds ?? "").split(" ").filter(Boolean), tags: (element.dataset.tags ?? "").split(" ").filter(Boolean), topic: element.dataset.topic ?? "", arxivSubmitted: element.dataset.arxivSubmitted ?? "", siteDate: element.dataset.siteDate ?? "",
    }));
    const visible = filterAndSortPapers(records, state, state.q ? matchedPathnames : null);
    cards.forEach((card) => { card.hidden = !visible.some((paper) => paper.element === card); });
    const container = list.querySelector("[data-paper-items]");
    visible.forEach((paper) => container?.append(paper.element));
    const count = list.querySelector("[data-paper-count]");
    if (count) count.textContent = String(visible.length);
    const empty = list.querySelector("[data-paper-empty]");
    if (empty instanceof HTMLElement) empty.hidden = visible.length !== 0;
  }

  async function search(query: string, sequence = ++searchSequence) {
    const status = document.querySelector("[data-search-status]");
    if (!query.trim()) {
      matchedPathnames = null;
      if (status) status.textContent = "検索語を入力すると全文検索できます。";
      updatePaperList();
      return;
    }
    if (status) status.textContent = "検索中…";
    try {
      const base = document.documentElement.dataset.baseUrl ?? "/";
      const pagefind = await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
      await pagefind.options({ baseUrl: base });
      await pagefind.init();
      const response = await pagefind.search(normalizeSearchQuery(query));
      const results = await Promise.all(response.results.map((result: { data: () => Promise<{ meta?: Record<string, string> }> }) => result.data()));
      if (sequence !== searchSequence) return;
      matchedPathnames = new Set(results.map((result) => result.meta?.pathname).filter((value): value is string => Boolean(value)));
      if (status) status.textContent = matchedPathnames.size ? `${matchedPathnames.size}件の論文が全文検索に一致しました。` : "全文検索に一致する論文はありません。";
    } catch (error) {
      if (sequence !== searchSequence) return;
      matchedPathnames = null;
      if (status) status.textContent = "全文検索を読み込めませんでした。絞り込み一覧と各論文へのリンクは引き続き利用できます。";
      console.error("Pagefind search failed", error);
    }
    updatePaperList();
  }
  let debounceTimer: number | undefined;
  document.addEventListener("submit", (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches("[data-filter-bar]")) return;
    event.preventDefault();
    clearTimeout(debounceTimer);
    const state = controls(form);
    history.pushState({}, "", `${location.pathname}${stateToSearch(state)}`);
    void search(state.q);
  });
  document.addEventListener("change", (event) => {
    const form = (event.target instanceof Element) ? event.target.closest("[data-filter-bar]") : null;
    if (!(form instanceof HTMLFormElement)) return;
    if (event.target instanceof HTMLInputElement && event.target.name === "authorName") {
      const authorInput = event.target;
      const option = [...form.querySelectorAll<HTMLOptionElement>("#author-options option")].find((candidate) => candidate.value === authorInput.value);
      const hidden = form.elements.namedItem("author"); if (hidden instanceof HTMLInputElement) hidden.value = option?.dataset.authorId ?? "all";
    }
    history.pushState({}, "", `${location.pathname}${stateToSearch(controls(form))}`);
    updatePaperList();
  });
  document.addEventListener("input", (event) => {
    if (!(event.target instanceof HTMLInputElement) || event.target.name !== "q") return;
    const input = event.target;
    const form = input.closest("[data-filter-bar]");
    if (!(form instanceof HTMLFormElement)) return;
    clearTimeout(debounceTimer);
    const sequence = ++searchSequence;
    const query = input.value;
    debounceTimer = window.setTimeout(() => {
      history.pushState({}, "", `${location.pathname}${stateToSearch(controls(form))}`);
      void search(query, sequence);
    }, 180);
  });
  addEventListener("popstate", () => { updatePaperList(); const state = readFilterState(location.search, [], []); void search(state.q); });
  updatePaperList();
  const initialQuery = new URLSearchParams(location.search).get("q") ?? "";
  if (initialQuery) void search(initialQuery);
</script>
